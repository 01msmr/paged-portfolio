# Caching und Kompression (Apache / Plesk bei netcup; nginx ignoriert die Datei)

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/manifest+json
</IfModule>

# Nicht öffentlich: die Seite wird per git pull im öffentlichen Ordner aktualisiert, also läge sonst alles offen
<IfModule mod_alias.c>
  RedirectMatch 404 /\.git
  RedirectMatch 404 ^/(tools|_source)/
</IfModule>
<IfModule mod_authz_core.c>
  # projects.json liest PHP direkt vom Dateisystem; site.webmanifest.php (.php) ist nicht betroffen
  <FilesMatch "\.(py|pyc|md|json)$">
    Require all denied
  </FilesMatch>
</IfModule>

# /favicon.ico (Crawler, Link-Vorschauen, Lesezeichen, Safari) liefert das eigene Icon; der Hoster legt sonst sein Standard-Icon dorthin.
# Die Datei entsteht mit tools/icons.py (Farbe des ersten Projekts); die Seite selbst nennt ihre Icons mit ?v= (index.php).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^favicon\.ico$ app-icons/favicon.ico [L]
</IfModule>

<IfModule mod_headers.c>
  # Gilt auch für Bilder, Schrift und Skripte (die übrigen Sicherheits-Kopfzeilen setzt index.php)
  Header always set X-Content-Type-Options "nosniff"
  # Seite immer frisch holen
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Bilder tragen ?v=… in der URL: bei Änderung Nummer erhöhen, sonst ein Jahr gültig
  <FilesMatch "\.(webp|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # CSS und JS tragen ?v=<Änderungszeit> (index.php): ein Jahr gültig
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Schriften ändern sich praktisch nie
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
